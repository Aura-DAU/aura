# Copy to .env.local and fill in values. Never commit .env.local.

# Base URL of the AURA RAG FastAPI backend (see server/README.md).
# The Next.js route handlers in app/api/chat and app/api/speech proxy to this.
BACKEND_URL=http://localhost:8000

# NextAuth / Google OAuth (required in production — no mock fallbacks)
NEXTAUTH_SECRET=generate_with_openssl_rand_hex_32
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match FastAPI INTERNAL_JWT_SECRET / INTERNAL_RESOLVE_SECRET
INTERNAL_JWT_SECRET=
INTERNAL_RESOLVE_SECRET=
