# Base URL of the AURA RAG FastAPI backend
BACKEND_URL=http://localhost:8000

# NextAuth configuration for local development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_key_here

# Google SSO credentials (same OAuth App as Calendar)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Internal secrets shared between Next.js and FastAPI
INTERNAL_JWT_SECRET=your_internal_jwt_secret_here
INTERNAL_RESOLVE_SECRET=your_internal_resolve_secret_here
