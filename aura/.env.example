# Copy to .env.local and fill in values. Never commit .env.local.

# Base URL of the AURA RAG FastAPI backend (see server/rag).
# The Next.js route handlers in app/api/chat and app/api/speech proxy to this.
BACKEND_URL=http://localhost:8000

# NextAuth / Google OAuth (required in production — no mock fallbacks)
NEXTAUTH_SECRET=generate_with_openssl_rand_hex_32
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local/demo login only — never set ENABLE_DEMO_ACCOUNTS=true in a deployed
# environment; it is hard-blocked when NODE_ENV=production regardless.
# Passwords must be set explicitly; there is no in-source default.
ENABLE_DEMO_ACCOUNTS=false
DEMO_STUDENT_PASSWORD=
DEMO_FACULTY_PASSWORD=
DEMO_ADMIN_PASSWORD=

# Must match FastAPI INTERNAL_JWT_SECRET / INTERNAL_RESOLVE_SECRET
INTERNAL_JWT_SECRET=
INTERNAL_RESOLVE_SECRET=
