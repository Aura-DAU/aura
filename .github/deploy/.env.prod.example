# AURA production env — copy to .env.prod and fill in. Never commit .env.prod.
#
#   cp deploy/.env.prod.example deploy/.env.prod
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.prod up -d --build
#
# With host GPUs (vllm-node1/2/3):
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.prod --profile gpu up -d --build

# ── Postgres ───────────────────────────────────────────────────────────
POSTGRES_USER=aura_app
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=aura_auth

# ── Public URLs / CORS ─────────────────────────────────────────────────
# Public HTTPS origin of the Next.js app (required when backend ENV=production)
PROD_FRONTEND_ORIGIN=https://aura.dau.ac.in
NEXTAUTH_URL=https://aura.dau.ac.in

# ── NextAuth / Google OAuth (aura frontend) ────────────────────────────
# Generate: openssl rand -hex 32
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Shared secrets (aura ↔ backend) ────────────────────────────────────
# Generate each: python -c "import secrets; print(secrets.token_hex(32))"
# Must be ≥ 256 bits (64 hex chars). Must match on both services.
INTERNAL_JWT_SECRET=
INTERNAL_RESOLVE_SECRET=

# ── Inference pool (InferenceRouter → vLLM) ────────────────────────────
# Comma-separated OpenAI-compatible base URLs (must end with /v1).
#
# Same-host Compose DNS (default when using --profile gpu):
#   VLLM_ENDPOINTS=http://vllm-node1:8000/v1,http://vllm-node2:8000/v1,http://vllm-node3:8000/v1
#
# Multi-host GPU cluster — put reachable LAN IPs or hostnames here instead, and
# note that the published port can differ per host. On the live DAU cluster the
# gateway node publishes :8001→container:8000 (host :8000 is the FastAPI backend
# and 404s on /v1/models) while the two dedicated GPU hosts serve :8000 directly:
#   VLLM_ENDPOINTS=http://10.100.97.71:8001/v1,http://10.100.97.72:8000/v1,http://10.100.97.73:8000/v1
# Verify each host before deploying: curl -s http://<host>:<port>/v1/models
# That multi-host layout is maintained in node1/.env.node1.example; this file
# keeps the Compose DNS form deliberately. Do not copy one over the other.
#
# Single GPU: one URL is enough (no failover).
VLLM_ENDPOINTS=http://vllm-node1:8000/v1,http://vllm-node2:8000/v1,http://vllm-node3:8000/v1
# Must match the served id from GET /v1/models (live cluster often uses aura-llm
# via --served-model-name, not the HuggingFace repo id).
VLLM_MODEL=aura-llm
VLLM_API_KEY=EMPTY

# vLLM scheduler ceiling (GPU-08). Consumed by docker-compose as
# --max-num-seqs; the compose default is 24, matching the pin below.
# Measured KV cache is 23,856 tokens — kv_cache_max_concurrency=2.91 at
# max_model_len=8192 — and the live nodes never exceed num_requests_running=24.
# Raising it lets the scheduler admit sequences KV has no room for, so
# they preempt and recompute instead of running: worse throughput and a p95
# cliff, not more capacity. 24 matches today's live ceiling and KV reality.
# Revisit upward only after a max_model_len cutover (e.g. toward 4096), which
# buys real concurrency per token budget rather than oversubscribing it.
VLLM_MAX_NUM_SEQS=24

# InferenceRouter httpx pool + chat admission (per uvicorn worker — not global).
# Total admitted ≈ CHAT_CONCURRENCY × BACKEND_WORKERS × api_replicas.
VLLM_MAX_KEEPALIVE=64
VLLM_MAX_CONNECTIONS=256
VLLM_READ_TIMEOUT=120
# Queue-aware routing (GPU-07). A background thread polls each node's vLLM
# /metrics and the router prefers the shallowest real queue, correcting for the
# fact that the in-flight counter is per uvicorn worker and blind to siblings.
# Fails open to plain least-connections on a failed or stale scrape.
# Set VLLM_QUEUE_AWARE=0 to disable without a code change.
VLLM_QUEUE_AWARE=1
VLLM_QUEUE_SCRAPE_INTERVAL=2.0
VLLM_QUEUE_STALE_AFTER=6.0
VLLM_QUEUE_SCRAPE_TIMEOUT=1.0
# KV-cache pressure folded into the same sample: no penalty below _SOFT, scaling
# to _PENALTY phantom requests at 100% usage. Measured KV on the live nodes is
# 23,856 tokens (~2.9 full-length sequences), so they thrash on long RAG prompts
# well before max_num_seqs=24. Set VLLM_QUEUE_KV_PENALTY=0 to ignore KV.
VLLM_QUEUE_KV_SOFT=0.85
VLLM_QUEUE_KV_PENALTY=8.0
CHAT_CONCURRENCY=24
CHAT_QUEUE_WAIT_TIMEOUT=2

# ── Qdrant ─────────────────────────────────────────────────────────────
# One-box Compose: leave default (http://qdrant:6333 via compose).
# Multi-host: point at Node 4, e.g. http://10.100.97.74:6333
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=aura-knowledge-base

# ── Backend workers / retrieval device ─────────────────────────────────
# Each worker lazily loads embedder + reranker; keep low unless you have RAM.
BACKEND_WORKERS=2
# Prefer Node 4 microservice (must be listed in compose `environment:` too).
EMBEDDING_SERVICE_URL=http://10.100.97.74:8001
RERANKER_SERVICE_URL=http://10.100.97.74:8001
# Local fallback only. Use cpu unless the backend container has NVIDIA runtime.
# Never set cuda on Node 1 without --gpus — chat dies with "no NVIDIA driver".
RERANKER_DEVICE=cpu

# ── Google Calendar (backend) ──────────────────────────────────────────
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CALENDAR_VAULT_KEY=

# ── eCampus vault (required in production when ERP_DB_HOST is unset) ───
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ECAMPUS_VAULT_KEY=

# ── Observability ──────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin
# OBS-01: shared directory so /metrics aggregates every gunicorn/uvicorn worker.
# Without this, scrapes alternate between per-worker counters and the inference
# dispatch split (aura_inference_node_requests_total) is unverifiable.
# Path must be writable by the aura user and shared by every worker in the
# container — /var/lib/aura/prometheus sits on the existing aura-vault volume.
# Compose must pass this into the backend service environment (and keep the
# vault volume mounted); the value alone in this file is not enough.
PROMETHEUS_MULTIPROC_DIR=/var/lib/aura/prometheus
