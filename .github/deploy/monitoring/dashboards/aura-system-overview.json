{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Backend Request Rate (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(aura_http_requests_total[1m])) by (status)",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Request Latency P95 (Seconds)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(aura_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95 Latency",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "RAG Pipeline Stage Latency (Avg)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(aura_chat_stage_duration_seconds_sum[5m])) by (stage) / sum(rate(aura_chat_stage_duration_seconds_count[5m])) by (stage)",
          "legendFormat": "Stage: {{stage}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "vLLM Dispatched Requests per Node",
      "description": "Backend InferenceRouter dispatch counters (aura_inference_node_requests_total). Requires PROMETHEUS_MULTIPROC_DIR so every gunicorn worker is aggregated; without it scrapes alternate between workers and the split is unverifiable (OBS-01).",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(aura_inference_node_requests_total[1m])) by (node)",
          "legendFormat": "rate {{node}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(increase(aura_inference_node_requests_total[5m])) by (node)",
          "legendFormat": "5m Δ {{node}}",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 5,
      "title": "NGINX Edge Load by Route",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(nginx_http_response_count_total[1m])) by (request_uri)",
          "legendFormat": "Route: {{request_uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 6,
      "title": "vLLM Inference Engine Queue & Running Requests",
      "description": "Ground-truth GPU queues from each vLLM node's own /metrics. Use alongside the dispatch-share panel: a node with waiting≈0 that still absorbs most backend dispatches is the GPU-07 failure mode.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "vllm:num_requests_running",
          "legendFormat": "running {{instance}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "vllm:num_requests_waiting",
          "legendFormat": "waiting {{instance}}",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 7,
      "title": "vLLM Token Generation Speed (Tok/s)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "vllm:avg_generation_throughput_tok_per_s",
          "legendFormat": "tok/s {{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 16 },
      "id": 8,
      "title": "Inference Dispatch Share (5m)",
      "description": "Fraction of InferenceRouter dispatches per node over the last 5 minutes. Use this panel to confirm a routing fix (W1 / GPU-01) actually rebalanced the pool — every node should take a non-zero share under load once OBS-01 multiprocess collection is on.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(increase(aura_inference_node_requests_total[5m])) by (node) / ignoring(node) group_left sum(increase(aura_inference_node_requests_total[5m]))",
          "legendFormat": "share {{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["aura", "monitoring"],
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m"]
  },
  "timezone": "browser",
  "title": "AURA System Observability",
  "uid": "aura-system-overview",
  "version": 1
}
