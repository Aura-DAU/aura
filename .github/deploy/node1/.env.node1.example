# Node 1 (Gateway Node) Environment Configuration
#
# Copy to `.env` in this directory and replace EVERY secret below with a strong,
# unique, random value. Never commit the filled-in .env. The placeholders here
# are NOT safe for production — deploying them ships known credentials.
NEXTAUTH_URL=https://aura.dau.ac.in
# Generate: openssl rand -hex 32
NEXTAUTH_SECRET=change-this-nextauth-secret-32-chars
GOOGLE_CLIENT_ID=google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=google-client-secret
# Generate each (>=256-bit): python -c "import secrets; print(secrets.token_hex(32))"
# Must match the values configured on the backend service.
INTERNAL_JWT_SECRET=change-this-internal-jwt-secret
INTERNAL_RESOLVE_SECRET=change-this-internal-resolve-secret

POSTGRES_USER=aura
# Use a strong random password — do not deploy with this placeholder.
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=auradb

PROD_FRONTEND_ORIGIN=https://aura.dau.ac.in
BACKEND_WORKERS=4
# Shared question quota across workers — required in production (compose sets this).
# REDIS_URL is injected by docker-compose; do not leave Redis unpublished/unreachable.
# CHAT_CONCURRENCY is PER uvicorn worker (not cluster-wide). For 1000-user
# bursts on a multi-GPU pool use ~24 here (×4 workers ≈ 96 admitted/replica);
# do not set 1000 — excess should 503 with Retry-After instead of stomping vLLM.
CHAT_CONCURRENCY=24
CHAT_QUEUE_WAIT_TIMEOUT=2

# Inter-Node Communication URLs (Replace <NODE_X_IP> with Ubuntu Node LAN IPs)
# PORTS DIFFER PER NODE — they are not a typo:
#   Node 1 (this gateway host) publishes vLLM as :8001→container:8000, because
#     host :8000 is the FastAPI backend and returns 404 on /v1/models.
#   Nodes 2 and 3 are dedicated GPU hosts and publish vLLM directly on :8000.
# Wrong port → chat soft-errors ("Sorry, I encountered an error while
# generating"). Verify each node before deploying:
#   curl -s http://<NODE_1_IP>:8001/v1/models
#   curl -s http://<NODE_2_IP>:8000/v1/models
#   curl -s http://<NODE_3_IP>:8000/v1/models
#
# Keep all three nodes here. A single-node pool has nowhere to fail over to and
# silently undoes the InferenceRouter's load spreading — the whole cluster ends
# up pinned to the gateway GPU, which is also the one sharing CPU with nginx.
VLLM_ENDPOINTS=http://<NODE_1_IP>:8001/v1,http://<NODE_2_IP>:8000/v1,http://<NODE_3_IP>:8000/v1
# Single-node fallback — ONLY when nodes 2/3 are genuinely down or not yet built.
#   VLLM_ENDPOINTS=http://<NODE_1_IP>:8001/v1
#
# Relationship to ../.env.prod.example: that file is for the one-box Compose
# deployment and addresses the pool over Compose DNS
# (http://vllm-node{1,2,3}:8000/v1), where every node is an in-network container
# on :8000. This file is the multi-host cluster layout and must use LAN IPs with
# each host's *published* port. The two are deliberately different; do not copy
# one over the other.
# Must match the served model id from GET /v1/models (e.g. aura-llm).
VLLM_MODEL=aura-llm
VLLM_MODEL_PATH=Qwen/Qwen3-32B-AWQ
VLLM_API_KEY=EMPTY

# vLLM scheduler ceiling (GPU-08). Consumed by docker-compose as
# --max-num-seqs; the compose default is 24, matching the pin below.
# Measured KV cache is 23,856 tokens — kv_cache_max_concurrency=2.91 at
# max_model_len=8192 — and the live nodes never exceed num_requests_running=24.
# Raising it lets the scheduler admit sequences KV has no room for, so
# they preempt and recompute instead of running: worse throughput and a p95
# cliff, not more capacity. 24 matches today's live ceiling and KV reality.
# Revisit upward only after a max_model_len cutover (e.g. toward 4096), which
# buys real concurrency per token budget rather than oversubscribing it.
VLLM_MAX_NUM_SEQS=24

# InferenceRouter connection pool — sized for classifier fan-out + generations.
VLLM_MAX_KEEPALIVE=64
VLLM_MAX_CONNECTIONS=256
VLLM_READ_TIMEOUT=120

# Queue-aware routing (GPU-07). The router polls each node's vLLM /metrics in a
# background thread and prefers the node with the shallowest real queue, instead
# of trusting a per-worker in-flight count that cannot see sibling workers.
# Fails open: a failed or stale scrape falls back to local least-connections.
# Set VLLM_QUEUE_AWARE=0 to disable without a code change.
VLLM_QUEUE_AWARE=1
VLLM_QUEUE_SCRAPE_INTERVAL=2.0
VLLM_QUEUE_STALE_AFTER=6.0
VLLM_QUEUE_SCRAPE_TIMEOUT=1.0
# KV-cache pressure is folded into the same sample. It matters here: measured KV
# on these nodes is only 23,856 tokens (~2.9 full-length sequences), so a node
# thrashes on long RAG prompts well before it reaches max_num_seqs=24. No
# penalty below _SOFT, scaling to _PENALTY phantom requests at 100% usage.
# Set VLLM_QUEUE_KV_PENALTY=0 to score on request counts alone.
VLLM_QUEUE_KV_SOFT=0.85
VLLM_QUEUE_KV_PENALTY=8.0

QDRANT_URL=http://<NODE_4_IP>:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=aura-knowledge-base

EMBEDDING_SERVICE_URL=http://<NODE_4_IP>:8001
RERANKER_SERVICE_URL=http://<NODE_4_IP>:8001
# Local fallback only (when Node 4 is unreachable). Must be cpu unless the
# backend container itself has NVIDIA runtime + GPU device mounted.
# Do NOT set cuda on Node 1 — that crashes chat with "Found no NVIDIA driver".
RERANKER_DEVICE=cpu

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://aura.dau.ac.in/backend/calendar/callback
# Generate each: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CALENDAR_VAULT_KEY=replace-with-generated-fernet-key
# Last day of the current semester (YYYY-MM-DD). Bounds the recurring timetable
# events (RRULE UNTIL). Timetable sync errors out until this is set — update it
# each semester.
GOOGLE_CALENDAR_SEMESTER_END=2026-11-27
ECAMPUS_VAULT_KEY=replace-with-generated-fernet-key
# Use a strong random password — do not deploy with the default 'admin'.
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
# OBS-01: shared directory so /metrics aggregates every gunicorn/uvicorn worker.
# Without this, scrapes alternate between per-worker counters and the inference
# dispatch split (aura_inference_node_requests_total) is unverifiable.
# Path must be writable by the aura user and shared by every worker in the
# container — /var/lib/aura/prometheus sits on the existing aura-vault volume.
# Compose must pass this into the backend service environment (and keep the
# vault volume mounted); the value alone in this file is not enough.
PROMETHEUS_MULTIPROC_DIR=/var/lib/aura/prometheus

# ── Cluster SSH deploy (Node 1 → Nodes 2/3/4) ──────────────────────────────
# Used by deploy/scripts/deploy-node{2,3,4}.sh and CD job deploy-node4-monitoring.
# Private key stays on Node 1 at AURA_SSH_KEY — never commit the key or put it
# in GitHub secrets if it already lives on the gateway host.
# AURA_SSH_USER=aura
# AURA_SSH_KEY=/opt/aura/.ssh/cluster_deploy
# AURA_REMOTE_APP_ROOT=/opt/aura/app
# AURA_NODE2_HOST=<NODE_2_IP>
# AURA_NODE3_HOST=<NODE_3_IP>
# AURA_NODE4_HOST=<NODE_4_IP>
# Per-node SSH logins when they differ from AURA_SSH_USER:
# AURA_NODE2_SSH_USER=aura2
# AURA_NODE3_SSH_USER=aura3
# AURA_NODE4_SSH_USER=aura4
