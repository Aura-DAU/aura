# ============================================================
# Option A: Anthropic Claude (claude-sonnet-4-6)
# Used when OPENAI_API_KEY is not set.
# ============================================================
ANTHROPIC_API_KEY=

# ============================================================
# Option B: OpenAI-compatible endpoint
# Priority over Anthropic when set.
# Examples:
#   - Qwen3-32B via vLLM:   OPENAI_BASE_URL=http://localhost:8000/v1
#   - GPT-4o-mini:          OPENAI_BASE_URL=https://api.openai.com/v1
#   - Groq:                 OPENAI_BASE_URL=https://api.groq.com/openai/v1
# ============================================================
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_MODEL=Qwen/Qwen3-32B

# ============================================================
# RAG corpus
# ============================================================

# Absolute or relative path to the data directory containing .md document folders.
# Defaults to ../../data (two levels up from backend/) — matches the repo layout.
DATA_DIR=../../data

# Sentence-Transformers model for semantic embeddings (CPU-friendly default)
EMBED_MODEL=all-MiniLM-L6-v2

# Number of top documents retrieved per query
TOP_K=5

# ============================================================
# Server
# ============================================================

# Comma-separated CORS origins accepted by the backend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
