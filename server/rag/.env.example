# Copy to .env and fill in values. Never commit .env.
# Loaded via python-dotenv at pipeline startup.

# ── RAG pipeline (required) ───────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=
GROQ_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: override default Groq model
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Auth — SSO architecture ───────────────────────────────────────────────
# Authentication is owned by NextAuth.js (Google SSO). FastAPI only
# verifies the short-lived internal JWT that Next.js mints.

# Shared secret: Next.js mints JWTs with this, FastAPI verifies them.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# Must be ≥256 bits. Never commit.
INTERNAL_JWT_SECRET=

# Secret for GET /internal/resolve-identity — Next.js sends this header.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_RESOLVE_SECRET=

# ── AURA Auth DB ──────────────────────────────────────────────────────────
# PostgreSQL for user_identity_map, role_bindings, audit_log (no passwords).
# Format: postgresql://aura_app:<password>@<host>:5432/aura_auth
AUTH_DB_URL=

# ── ERP / eCampus ─────────────────────────────────────────────────────────
# If DAU IT provides direct DB access → set these for SQL mode (recommended):
# ERP_DB_HOST=
# ERP_DB_PORT=5432
# ERP_DB_NAME=
# ERP_DB_USER=aura_readonly
# ERP_DB_PASS=

# If direct DB unavailable → leave ERP_DB_HOST unset → scrape mode.
ECAMPUS_BASE_URL=https://ecampus.daiict.ac.in

# Fernet key for per-student eCampus credential vault (scrape mode only):
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ECAMPUS_VAULT_KEY=

# Paths for scraper SQLite DBs (defaults fine for most setups):
# ECAMPUS_VAULT_DB=/var/lib/aura/ecampus_credentials.db
# ECAMPUS_TIMETABLE_POOL_DB=/var/lib/aura/timetable_pool.db

# ── Audit log ─────────────────────────────────────────────────────────────
# AURA_AUDIT_LOG=/var/log/aura/personal_data_audit.log
# AUDIT_ARCHIVE_AGE_DAYS=90
# AUDIT_ARCHIVE_DIR=/var/lib/aura/audit_archive
# AURA_ADMIN_DB_URL=   # higher-privilege connection for archiver DELETE

# ── Production ────────────────────────────────────────────────────────────
# PROD_FRONTEND_ORIGIN=https://aura.dau.ac.in
# PRODUCTION=1   # enables HTTPS-only cookies and strict SameSite
