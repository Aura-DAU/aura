# AURA Database Configuration
AUTH_DB_URL=postgresql://aura_app:password@localhost:5432/aura_auth
# AURA_ADMIN_DB_URL=postgresql://aura_app:password@localhost:5432/aura_auth

# CORS & Frontend Origins
PROD_FRONTEND_ORIGIN=https://aura.dau.ac.in

# External Binaries Path
FFMPEG_BINARY_PATH=

# AURA Session & JWT Secrets
# Shared secret: Next.js mints JWTs with this, FastAPI verifies them.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be >= 256 bits (64 hex characters). Never commit.
INTERNAL_JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# Secret for GET /internal/resolve-identity — Next.js sends this header.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_RESOLVE_SECRET=your_resolve_secret_key

# Google Calendar OAuth Integration
GOOGLE_CALENDAR_CLIENT_ID=your_google_calendar_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_calendar_client_secret
# Fernet key for encrypting Google Calendar tokens in SQLite:
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CALENDAR_VAULT_KEY=your_fernet_vault_encryption_key
GOOGLE_CALENDAR_VAULT_DB=/var/lib/aura/google_calendar_vault.db
REDIRECT_URI=http://localhost:3000/api/auth/callback/google-calendar

# LLM Inference Providers
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# eCampus Integration & Scraping
# Fernet key for per-student eCampus credential vault (scrape mode only):
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ECAMPUS_VAULT_KEY=your_ecampus_vault_encryption_key
ECAMPUS_VAULT_DB=/var/lib/aura/ecampus_credentials.db
ECAMPUS_BASE_URL=https://ecampus.daiict.ac.in
ECAMPUS_TIMETABLE_POOL_DB=/var/lib/aura/timetable_pool.db

# Vector Knowledge Base
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=your_pinecone_index_name
DISABLE_PINECONE_DLS_FILTER=false

# Audit Logs
AURA_AUDIT_LOG=/var/log/aura/personal_data_audit.log
AUDIT_ARCHIVE_BUCKET=your_s3_audit_archive_bucket
AUDIT_ARCHIVE_AGE_DAYS=90
AUDIT_ARCHIVE_DIR=/var/lib/aura/audit_archive

# Optional SQL ERP Direct Connection (if SQL mode is active)
# ERP_DB_HOST=localhost
# ERP_DB_PORT=5432
# ERP_DB_NAME=erp_db
# ERP_DB_USER=aura_readonly
# ERP_DB_PASS=password

# Debugging
DEBUG=false
