# AURA Database Configuration
AUTH_DB_URL=postgresql://aura_app:password@localhost:5432/aura_auth
# AURA_ADMIN_DB_URL=postgresql://aura_app:password@localhost:5432/aura_auth

# Set to production to enforce required secrets / CORS origin at startup
# ENV=production

# CORS & Frontend Origins (required when ENV=production)
PROD_FRONTEND_ORIGIN=https://aura.dau.ac.in

# Shared question quota across API workers (omit for single-process in-memory)
# REDIS_URL=redis://localhost:6379/0
# Optional key prefix for per-user persistent memory stored in Redis.
# REDIS_USER_MEMORY_PREFIX=aura:user-memory:

# Optional: restrict /internal/* to Next.js BFF IPs/CIDRs (comma-separated)
# INTERNAL_RESOLVE_ALLOWLIST=10.0.0.0/8,127.0.0.1

# External Binaries Path
FFMPEG_BINARY_PATH=

# AURA Session & JWT Secrets
# Shared secret: Next.js mints JWTs with this, FastAPI verifies them.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be >= 256 bits (64 hex characters). Never commit.
INTERNAL_JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# Secret for GET /internal/resolve-identity — Next.js sends this header.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_RESOLVE_SECRET=your_resolve_secret_key

# Google Calendar OAuth Integration
GOOGLE_CALENDAR_CLIENT_ID=your_google_calendar_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_calendar_client_secret
# Fernet key for encrypting Google Calendar tokens in SQLite:
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CALENDAR_VAULT_KEY=your_fernet_vault_encryption_key
GOOGLE_CALENDAR_VAULT_DB=/var/lib/aura/google_calendar_vault.db
REDIRECT_URI=http://localhost:3000/api/auth/callback/google-calendar

# LLM Inference — self-hosted vLLM inference pool (architecture doc §13–16)
# Comma-separated OpenAI-compatible base URLs, one per vLLM node
# (e.g. "vllm serve Qwen/Qwen3-32B-AWQ --port 8000" on each GPU node).
# A single URL is fine too — InferenceRouter treats a 1-node pool the same
# way, it just has nowhere to fail over to.
VLLM_ENDPOINTS=http://vllm-node1:8000/v1,http://vllm-node2:8000/v1,http://vllm-node3:8000/v1
VLLM_MODEL=Qwen/Qwen3-32B-AWQ
# Most vLLM deployments don't check this, but the OpenAI client requires a
# non-empty value.
VLLM_API_KEY=EMPTY
# Legacy (pre-migration) — no longer read by anything in pipeline/, kept
# only so the deprecated upload_to_pinecone.py / key_manager.py still run
# if invoked manually.
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile

# eCampus Integration & Scraping
# Fernet key for per-student eCampus credential vault (scrape mode only):
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production when ERP_DB_HOST is unset. Keep DB file mode 0600.
ECAMPUS_VAULT_KEY=your_ecampus_vault_encryption_key
ECAMPUS_VAULT_DB=/var/lib/aura/ecampus_credentials.db
ECAMPUS_BASE_URL=https://ecampus.daiict.ac.in
ECAMPUS_TIMETABLE_POOL_DB=/var/lib/aura/timetable_pool.db

# Vector Knowledge Base
# Node 4 embedding-reranker (.github/deploy/node4) — port 8001, not legacy TEI :8081
EMBEDDING_URL=http://10.100.97.74:8001
EMBEDDING_SERVICE_URL=http://10.100.97.74:8001
QDRANT_URL=http://10.100.97.74:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=aura_documents
DISABLE_DLS_FILTER=false
DISABLE_PINECONE_DLS_FILTER=false
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=your_pinecone_index_name

# Audit Logs
AURA_AUDIT_LOG=/var/log/aura/personal_data_audit.log
AUDIT_ARCHIVE_BUCKET=your_s3_audit_archive_bucket
AUDIT_ARCHIVE_AGE_DAYS=90
AUDIT_ARCHIVE_DIR=/var/lib/aura/audit_archive

# Optional SQL ERP Direct Connection (if SQL mode is active)
# ERP_DB_HOST=localhost
# ERP_DB_PORT=5432
# ERP_DB_NAME=erp_db
# ERP_DB_USER=aura_readonly
# ERP_DB_PASS=password

# Debugging
DEBUG=false
