# Copy to .env and fill in values. Never commit .env.
# Loaded via python-dotenv at pipeline startup. PINECONE_* and
# GROQ_API_KEY are required — the API fails to start without them.

PINECONE_API_KEY=
PINECONE_INDEX=

GROQ_API_KEY=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PROD_FRONTEND_ORIGIN=https://your-university-url.com

# Optional: override the default Groq model (qwen/qwen3-32b)
# GROQ_MODEL=qwen/qwen3-32b
