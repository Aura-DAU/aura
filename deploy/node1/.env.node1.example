# Node 1 (Gateway Node) Environment Configuration
NEXTAUTH_URL=https://aura.daiict.ac.in
NEXTAUTH_SECRET=change-this-nextauth-secret-32-chars
GOOGLE_CLIENT_ID=google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=google-client-secret
INTERNAL_JWT_SECRET=change-this-internal-jwt-secret
INTERNAL_RESOLVE_SECRET=change-this-internal-resolve-secret

POSTGRES_USER=aura
POSTGRES_PASSWORD=aurasecret
POSTGRES_DB=auradb

PROD_FRONTEND_ORIGIN=https://aura.daiict.ac.in
BACKEND_WORKERS=4

# Inter-Node Communication URLs (Replace <NODE_X_IP> with Ubuntu Node LAN IPs)
VLLM_ENDPOINTS=http://<NODE_2_IP>:8000/v1,http://<NODE_3_IP>:8000/v1
VLLM_MODEL=Qwen/Qwen3-32B-AWQ
VLLM_API_KEY=EMPTY

QDRANT_URL=http://<NODE_4_IP>:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=aura-knowledge-base

EMBEDDING_SERVICE_URL=http://<NODE_4_IP>:8001
RERANKER_SERVICE_URL=http://<NODE_4_IP>:8001

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
