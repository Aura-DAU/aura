# Node 4 (Search, Vector & Infrastructure Node) Environment Configuration
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cuda
# Use a strong random password — do not deploy with the default 'admin'.
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
# Bind Qdrant + embedding ports to the private LAN IP (preferred), or leave
# 0.0.0.0 and enforce host firewall so 6333/6334/8001 are not internet-reachable.
# NODE4_PUBLISH_BIND=10.0.0.4
NODE4_PUBLISH_BIND=0.0.0.0
MAX_CONCURRENT_INFERENCE=2
MAX_REQUEST_BYTES=1048576
