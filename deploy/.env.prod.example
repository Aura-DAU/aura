# AURA production env — copy to .env.prod and fill in. Never commit .env.prod.
#
#   cp deploy/.env.prod.example deploy/.env.prod
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.prod up -d --build
#
# With host GPUs (vllm-node1/2/3):
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.prod --profile gpu up -d --build

# ── Postgres ───────────────────────────────────────────────────────────
POSTGRES_USER=aura_app
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=aura_auth

# ── Public URLs / CORS ─────────────────────────────────────────────────
# Public HTTPS origin of the Next.js app (required when backend ENV=production)
PROD_FRONTEND_ORIGIN=https://aura.dau.ac.in
NEXTAUTH_URL=https://aura.dau.ac.in

# ── NextAuth / Google OAuth (aura frontend) ────────────────────────────
# Generate: openssl rand -hex 32
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Shared secrets (aura ↔ backend) ────────────────────────────────────
# Generate each: python -c "import secrets; print(secrets.token_hex(32))"
# Must be ≥ 256 bits (64 hex chars). Must match on both services.
INTERNAL_JWT_SECRET=
INTERNAL_RESOLVE_SECRET=

# ── Inference pool (InferenceRouter → vLLM) ────────────────────────────
# Comma-separated OpenAI-compatible base URLs (must end with /v1).
#
# Same-host Compose DNS (default when using --profile gpu):
#   VLLM_ENDPOINTS=http://vllm-node1:8000/v1,http://vllm-node2:8000/v1,http://vllm-node3:8000/v1
#
# Multi-host GPU cluster — put reachable LAN IPs or hostnames here instead:
#   VLLM_ENDPOINTS=http://10.0.0.11:8000/v1,http://10.0.0.12:8000/v1,http://10.0.0.13:8000/v1
#
# Single GPU: one URL is enough (no failover).
VLLM_ENDPOINTS=http://vllm-node1:8000/v1,http://vllm-node2:8000/v1,http://vllm-node3:8000/v1
VLLM_MODEL=Qwen/Qwen3-32B-AWQ
VLLM_API_KEY=EMPTY

# ── Qdrant ─────────────────────────────────────────────────────────────
# One-box Compose: leave default (http://qdrant:6333 via compose).
# Multi-host: point at Node 4, e.g. http://10.100.97.74:6333
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=aura-knowledge-base

# ── Backend workers / retrieval device ─────────────────────────────────
# Each worker lazily loads embedder + reranker; keep low unless you have RAM.
BACKEND_WORKERS=2
# Prefer Node 4 microservice (must be listed in compose `environment:` too).
EMBEDDING_SERVICE_URL=http://10.100.97.74:8001
RERANKER_SERVICE_URL=http://10.100.97.74:8001
# Local fallback only. Use cpu unless the backend container has NVIDIA runtime.
# Never set cuda on Node 1 without --gpus — chat dies with "no NVIDIA driver".
RERANKER_DEVICE=cpu

# ── Google Calendar (backend) ──────────────────────────────────────────
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CALENDAR_VAULT_KEY=

# ── eCampus vault (required in production when ERP_DB_HOST is unset) ───
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ECAMPUS_VAULT_KEY=

# ── Observability ──────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin
