# Anthropic API Key for Claude Chat Integration
ANTHROPIC_API_KEY=

# Groq API Key for Whisper/Llama Audio transcription and alternate models
GROQ_API_KEY=

# FastAPI RAG Pipeline base URL (e.g. http://localhost:8000)
# When set, the AURA chat action proxies through the FastAPI backend first.
# If unset or if the backend is unreachable, the Anthropic SDK / offline fallback is used.
FASTAPI_RAG_URL=
